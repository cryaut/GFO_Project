    ],
    "is.sales_deduction_components": [
      "is.sales_returns",
      "is.sales_discounts",
      "is.sales_allowances"
    ]
  },
  "aggregation_rules": {
    "prefer_reported_subtotal": true,
    "subtotal_vs_components": {
      "selection_order": [
        "valid_reported_subtotal",
        "sum_recognized_components"
      ],
      "when_subtotal_selected": "exclude_components_from_this_aggregate",
      "preserve_original_component_values": true,
      "reconcile_subtotal_with_components": true,
      "on_difference": "use_selected_subtotal_and_raise_warning"
    },
    "component_missing_from_statement": "zero_for_aggregation",
    "unknown_imported_account": "review_not_zero",
    "invalid_or_blank_reported_value": "not_a_valid_subtotal"
  },
  "derived_values": {
    "costo_ventas": {
      "display_name": "Costo de ventas",
      "value_type": "flow",
      "reported_account_candidates": [
        "is.cost_of_sales_reported"
      ],
      "prefer_reported_value": true,
      "fallback_expression": {
        "op": "sum_accounts",
        "account_set": "is.cost_of_sales_components"
      },
      "when_reported_total_selected": "exclude_components_from_this_aggregate",
      "validate_against_components": true
    },
    "deducciones_ventas": {
      "display_name": "Deducciones de ventas",
      "value_type": "flow",
      "expression": {
        "op": "sum_accounts",
        "account_set": "is.sales_deduction_components"
      }
    },
    "utilidad_bruta": {
      "display_name": "Utilidad bruta",
      "value_type": "flow",
      "reported_account_candidates": [
        "is.gross_profit_reported"
      ],
      "prefer_reported_value": true,
      "fallback_expression": {
        "op": "subtract",
        "left": {
          "ref": "derived.ventas_netas"
        },
        "right": {
          "ref": "derived.costo_ventas"
        }
      },
      "when_reported_total_selected": "exclude_components_from_this_aggregate",
      "validate_against_components": true
    },
    "ventas_brutas": {
      "display_name": "Ventas brutas",
      "value_type": "flow",
      "reported_account_candidates": [
        "is.sales_total"
      ],
      "prefer_reported_value": true,
      "fallback_expression": {
        "op": "sum_accounts",
        "account_set": "is.gross_sales_components"
      },
      "when_reported_total_selected": "exclude_components_from_this_aggregate",
      "validate_against_components": true
    },
    "ventas_netas": {
      "display_name": "Ventas netas",
      "value_type": "flow",
      "reported_account_candidates": [
        "is.net_sales_reported"
      ],
      "prefer_reported_value": true,
      "fallback_expression": {
        "op": "subtract",
        "left": {
          "ref": "derived.ventas_brutas"
        },
        "right": {
          "ref": "derived.deducciones_ventas"
        }
      },
      "when_reported_total_selected": "exclude_components_from_this_aggregate",
      "validate_against_components": true
    }
  },
